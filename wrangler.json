{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dust-line-site",
  "main": "./worker/contact.mjs",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "preview_urls": false,
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "dustlineadv@gmail.com",
      "allowed_sender_addresses": ["contact-form@contact-mail.dustline.jp"]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "2026112601",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/contact"],
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
